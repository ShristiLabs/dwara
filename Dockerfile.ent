# Dockerfile.ent (DW-066): enterprise image on FROM scratch. Same static
# musl approach as Dockerfile.scratch, but built with the `ent` cargo
# feature so the image carries the CP/DP split binaries alongside the
# gateway:
#
#   /usr/local/bin/dwara            the gateway (dwara-bin, ent build)
#   /usr/local/bin/dwara-controller the control plane (dwara-cli)
#   /usr/local/bin/dwara-edge       the data-plane config relay (dwara-cli)
#
# There is deliberately NO ENTRYPOINT and NO default config: the three
# binaries are selected per deployment via the command (docker run
# argument or compose `command:`), and scratch has no shell so the
# command must be an absolute path to one of the binaries above. See
# quickstart/enterprise/docker-compose.yml for a full topology.
#
# PREREQUISITE: run quickstart/enterprise/vendor-licensing.sh first.
# The `ent` feature pulls licensing-core (BUSL-1.1, allow-listed in
# deny.toml) from the private ShristiLabs/licensing git repo, which a
# Docker build cannot authenticate to. The script clones it on the
# host (where your git credentials live) into
# quickstart/enterprise/vendor/licensing-core/, and the two COPY lines
# below consume it: the vendored crate plus a cargo source-replacement
# config so cargo resolves the git pin to the local copy. Without the
# vendor step this build fails at COPY -- by design, so the failure is
# a clear "run vendor-licensing.sh" rather than a spurious auth error.
#
# Build (local, native arch):
#   (cd quickstart/enterprise && ./vendor-licensing.sh)
#   docker build -f Dockerfile.ent -t dwara:ent .

ARG RUST_VERSION=1.94-alpine

FROM rust:${RUST_VERSION} AS builder
RUN apk add --no-cache musl-dev cmake make perl
WORKDIR /build
# Cargo metadata first so dependency compilation is layer-cached.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ crates/
# The vendored licensing-core (see PREREQUISITE above) and the cargo
# source-replacement config that redirects the private git pin to it.
# Both are generated by vendor-licensing.sh, which also derives the rev
# from the workspace Cargo.toml so nothing can drift.
COPY quickstart/enterprise/vendor/licensing-core/ /build/third-party/licensing-core/
COPY quickstart/enterprise/vendor/cargo-vendor.toml /build/.cargo/config.toml
# TARGETARCH is set by buildx (amd64/arm64); map to the musl triple.
ARG TARGETARCH
RUN case "${TARGETARCH:-$(uname -m | sed 's/aarch64/arm64/;s/x86_64/amd64/')}" in \
        amd64) echo 'x86_64-unknown-linux-musl' > /target.triple ;; \
        arm64) echo 'aarch64-unknown-linux-musl' > /target.triple ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac
RUN rustup target add "$(cat /target.triple)"
RUN cargo build --release --target "$(cat /target.triple)" --bin dwara -p dwara-bin --features ent
RUN cargo build --release --target "$(cat /target.triple)" --bin dwara-controller --bin dwara-edge -p dwara-cli --features ent

FROM scratch
COPY --from=builder /build/target/*/release/dwara /usr/local/bin/dwara
COPY --from=builder /build/target/*/release/dwara-controller /usr/local/bin/dwara-controller
COPY --from=builder /build/target/*/release/dwara-edge /usr/local/bin/dwara-edge
