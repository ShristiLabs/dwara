listeners:
  - name: main
    address: 0.0.0.0
    port: 8080
routes:
  - name: v1
    service: echo
    match:
      path:
        type: prefix
        value: /v1
    action:
      type: proxy
services:
  - name: echo
    upstream: u
upstreams:
  - name: u
    endpoints:
      - address: 127.0.0.1
        port: 9000
